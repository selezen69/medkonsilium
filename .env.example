HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Set to the HTTPS address behind your reverse proxy before exposing the server.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional one-time first-admin web setup: random secret, at least 32 characters.
# Leave empty to use npm run setup instead. Remove after the first account is created.
BOOTSTRAP_TOKEN=
# Optional. Set BOTH to enable the real AI service. No model is selected automatically.
OPENAI_API_KEY=
OPENAI_MODEL=
